            <span style="white-space: nowrap;">home finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">vehicle finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">interest rate calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">student finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">business finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">personal finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">emi calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">mortgage finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">salary calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">house finance calculator</span> <span style="color: var(--border-color);">|</span>
            <span style="white-space: nowrap;">superannuation retirement calculator</span>
          </div>
        </div>
      </details>
    </div>


  </section>
</Layout>
