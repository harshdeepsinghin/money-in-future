          <span class="arrow" style="font-size: 0.8rem; color: var(--text-secondary);">&darr;</span>
        </summary>
        <div style="margin-top: 1.25rem; cursor: default;">
          <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.75rem;">People Also Search For</h4>
          <div class="seo-tags-grid" style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem;">
            <a href="/calculators/sip?monthly=1000&years=10&currency=INR" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Money in future in rupees</a>
            <a href="/calculators/inflation" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Inflation calculator India</a>
            <a href="/calculators/inflation?principal=100000&years=10" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Value of 1 lakh after 10 years inflation</a>
            <a href="/" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Money in future calculator</a>
            <a href="/calculators/inflation?principal=100000&years=20" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Value of 1 lakh after 20 years inflation</a>
            <a href="/calculators/real-return" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Money in future value calculator</a>
            <a href="/calculators/real-return" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Money value calculator India</a>
            <a href="/calculators/inflation?principal=100000&years=25" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Value of 1 lakh after 25 years inflation</a>
            <a href="/calculators/fire" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Coast FIRE calculator</a>
            <a href="/calculators/retirement" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Free retirement calculator</a>
            <a href="/calculators/lump-sum" style="padding: 0.4rem 0.8rem; font-size: 0.8rem; font-weight: 500; border: 1px solid var(--border-color); border-radius: 20px; background: var(--bg-primary); color: var(--text-secondary); text-decoration: none; transition: all 0.2s;">Investment compounding planner</a>
